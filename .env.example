# Copy to .env for local dev, and set the same keys in Cloudflare Pages
# (Settings → Environment variables) for the deployed site.
# Never commit real keys. Never put the Supabase service-role key in the frontend.

# Supabase (public anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WhatsApp number used by the floating button + product enquiries (country code, no +)
VITE_WHATSAPP_NUMBER=919999999999

# Public site URL — used for canonical + OpenGraph tags (set to your real domain in prod)
VITE_SITE_URL=https://your-domain.com
